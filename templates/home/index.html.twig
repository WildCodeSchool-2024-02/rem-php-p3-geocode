{% extends 'base.html.twig' %}

{% block title %}Home{% endblock %}

{% block body %}
    {% for category, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ category }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}
    <div class="pink-stripe">
        <div class="logoff-button-container"><a href="{{ path('logout') }}">{{ ux_icon('hugeicons:logout-04', {class: 'logout-button'}) }} logout</a></div>
        <div class="user-car-info">
        {% if app.user.cars is empty %}
            <h1>Vous n'avez pas encore enregistré de véhicule :</h1>
            <p>Choisissez votre voiture <a href="{{ path('register_car') }}">ici</a></p>
        {% endif %}
        {% if app.user.cars %}
            {% for car in app.user.cars %}
                <h1>Votre véhicule principal :</h1>
                <h1>{{ car.model.brand }} {{ car.model.model }}</h1>
            {% endfor %}
        {% endif %}
        </div>
    </div>
    <div class="white-stripe">
        <img src="{{ asset('images/logol.png') }}" alt="">
        <h1>Bienvenue sur Géocode !</h1>
        <p><em><u>Votre</u></em> application pour trouver les bornes de recharge autour de vous, partout en France.</p>
        <br>
        <p>Avec une base de données de plus de 18 000 stations, vous ne serez jamais loin de nous.</p>
    </div>
{% endblock %}
