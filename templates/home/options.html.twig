{%  extends 'base.html.twig' %}

{% block body %}
    {# <div class="form_container"> #}


<main class="option-main">
    <div class="user-info">
        <p>Vos véhicules enregistrés :</p>
        <ul>
            {% for car in app.user.cars %}
                <li>{{ car.model.brand }} {{ car.model.model }} <a href="{{ path('dashboard_delete_car', {'car': car.id}) }}" onclick="return confirm('are u sure?')">{{ ux_icon('icon-park-twotone:delete-three', {class: 'delete-button'}) }}</a></li>
            {% endfor %}
        </ul>
        <p>Vous souhaitez ajouter un véhicule ? <a href="{{ path('register_car') }}" >{{ ux_icon('zondicons:add-solid', {class: "add-button"}) }}</a></p>
    </div>
</main>
{% endblock %}
