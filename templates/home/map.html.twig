{%  extends 'base.html.twig' %}

{% block javascripts %}
    {% block importmap %}{{ importmap('map') }}{% endblock %}
{% endblock %}

{% block body %}
    <div class="form_container">
                <main class="map-main">
            <section class="map-screen">
                <div id="map"></div>

            <!--
              The `defer` attribute causes the script to execute after the full HTML
              document has been parsed. For non-blocking uses, avoiding race conditions,
              and consistent behavior across browsers, consider loading using Promises. See
              https://developers.google.com/maps/documentation/javascript/load-maps-js-api
              for more information.
              -->
            <script src='/assets/map.js'></script>
            <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyCsCbly8V_UsYc2E8ebpocsVe1JAHFgF6U&callback=initMap&v=weekly"></script>
            <script src="https://unpkg.com/@googlemaps/markerclusterer/dist/index.min.js"></script>
            <script src="https://polyfill.io/v3/polyfill.min.js?features=default"></script>

            <script>
                window.initMap;

                const directionsService = new google.maps.DirectionsService();
                const directionsRenderer = new google.maps.DirectionsRenderer({suppressMarkers: true});
                const stations = {{ stations | raw }};
                const clientInfo = {{ clientInfo | raw }};
                const stationMark = "./../../assets/icons/greenmark.png";
                const icon = {
                    url: 'https://image.noelshack.com/fichiers/2024/25/4/1718884782-whitemark.png', // url
                    scaledSize: new google.maps.Size(75, 75),// size
                };
                const userIcon = {
                    url: 'https://image.noelshack.com/fichiers/2024/28/3/1720619699-user.png',
                    scaledSize: new google.maps.Size(50, 50),
                }
                const myLatLng = { lat: clientInfo.lat, lng: clientInfo.lon };
                const map = new google.maps.Map(document.getElementById("map"), {
                    zoom: 17,
                    center: myLatLng,
                    styles: [
                        {
                            "featureType": "poi",
                            "stylers": [
                                { "visibility": "off" }
                            ]
                        }
                    ],
                });


                directionsRenderer.setMap(map);
                function calcRoute(directionsService, directionsRenderer, property)
                {

                    var start = new google.maps.LatLng(clientInfo.lat, clientInfo.lon);
                    var end = new google.maps.LatLng(property.latitude, property.longitude);

                    var request = {
                        origin : start,
                        destination : end,
                        travelMode : 'DRIVING'
                    };
                    directionsService.route(request, function (response, status)
                    {
                        if (status === 'OK') {
                            directionsRenderer.setDirections(response);
                            document.getElementById(`route-info-${property.inseeCode}`).style.backgroundColor = '#525b5a'
                            document.getElementById(`distance-${property.inseeCode}`).innerHTML = "Distance " + response.routes[0].legs[0].distance.text + ",";
                            document.getElementById(`duration-${property.inseeCode}`).innerHTML = response.routes[0].legs[0].duration.text;
                        }
                    });
                    return end;
                }

                function deleteRoute(directionsService, directionsRenderer, property)
                {
                    directionsRenderer.set('directions', null);
                    document.getElementById(`route-info-${property.inseeCode}`).style.backgroundColor = '';
                    document.getElementById(`distance-${property.inseeCode}`).innerHTML = "";
                    document.getElementById(`duration-${property.inseeCode}`).innerHTML = '';
                }

                let infoWindow = new google.maps.InfoWindow({
                    content: '<h3>Borne rechargeable</h3>' +
                        '<button class="markr-btn">Delete me !</button>'
                });

                let infoWindow3 = new google.maps.InfoWindow({
                    content: '<h3>Borne rechargeable</h3>' +
                        '<button class="markr-btn">Delete me !</button>'
                });

                let lastOpened = null;

                function addMarker(property)
                {
                    let marker = new google.maps.Marker({
                        position: {lat:property.latitude, lng:property.longitude},
                        map: map,
                        icon: icon,
                        title: "Hello World!",
                    });

                    let infoWindow2 = new google.maps.InfoWindow({
                        content: '<h3>Borne rechargeable</h3>' +
                        '<button class="markr-btn">Delete me !</button>'
                    });

                    let contentString = "<div class='infowindow-container'>"+
                        "<h4>"+ property.stationName +"</h4>" +
                        "<p>"+ property.stationAddress +"</p>" +
                        "<p>Puissance de la borne : "+ property.maxPower +"kW</p>" +
                        "<div class=route-info id=route-info-"+ property.inseeCode +"><p class='distance' id=distance-" + property.inseeCode + " ></p><br><p id=duration-"+ property.inseeCode + "></p></div>" +
                        "<button id=infowindow-btn-"+ property.inseeCode + ">Se rendre à cette borne</button>"+
                        "<button id=delete-btn-"+ property.inseeCode + ">Supprimer l\'itinéraire</button>"+
                        "</div>";

                    function closeLastOpened() {
                        if (lastOpened) {
                            lastOpened.close();
                        }
                    }

                    marker.addListener('click', function () {
                        closeLastOpened();
                        infoWindow2.setContent(contentString);
                        infoWindow2.open(map, marker);
                        lastOpened = infoWindow2;
                    })

                    google.maps.event.addListener(infoWindow2, 'domready', function() {
                        document.getElementById(`infowindow-btn-${property.inseeCode}`).addEventListener("click", function() {
                            calcRoute(directionsService, directionsRenderer, property)
                            });
                        document.getElementById(`delete-btn-${property.inseeCode}`).addEventListener("click", function() {
                            deleteRoute(directionsService, directionsRenderer, property);
                        });
                    });

                    return marker;
                }

                let userMarker = new google.maps.Marker({
                    position: myLatLng,
                    map: map,
                    icon: userIcon,
                    title: "Vous êtes ici !",
                });
                userMarker.addListener('click', function () {
                    infoWindow.setContent('<h1>Vous êtes ici!</h1>');
                    infoWindow.open(map, userMarker);
                    console.log(clientInfo);
                })


                const markers = [];

                for (let i = 0; i < stations.length; i++) {
                    markers.push(addMarker(stations[i]));
                }

                const markerCluster = new markerClusterer.MarkerClusterer({ markers, map });


                </script>
                <div class="map-widget">
                    <img src="E:\WCC\wild-git\projet-3\assets\icons\greenmark.png" alt="">
                    {% include '/_includes/_footer-navbar.html.twig' %}
                </div>
            </section>
        </main>
    </div>
{% endblock %}
