{% extends 'base.html.twig' %}

{% block title %}Message{% endblock %}

{% block body %}
    <main class="dashboard-main">
        <div class="pink-stripe-admin">
            <p>Menu Admin</p>
            <p>Lecture du message</p>
        </div>
        <table class="table">
            <tbody>
                <tr>
                    <th>Expéditeur</th>
                    <td>{{ message.sender.email }}</td>
                </tr>
                <tr>
                    <th>Sujet du message</th>
                    <td>{{ message.topic.name }}</td>
                </tr>
                <tr>
                    <th>Message</th>
                    <td>{{ message.content }}</td>
                </tr>
            </tbody>
        </table>

    <p><a class="btn btn-secondary" href="{{ path('dashboard_messageList') }}">Liste des messages</a>

    <p><a class="btn btn-danger" href="{{ path('contact_message_delete', {'message': message.id}) }}">Supprimer</a></p>

{% endblock %}
