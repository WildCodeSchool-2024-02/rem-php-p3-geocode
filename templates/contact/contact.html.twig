        <div class="blurred-bg-img"><img src="{{ asset('images/logol.png') }}" alt=""></div>
            <div class="form_container">

    <div class="return-arrow">
        <a href="{{ path('home_index') }}">{{ ux_icon('cil:arrow-left') }}</a>
