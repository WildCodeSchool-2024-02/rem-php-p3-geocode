{% extends 'base.html.twig' %}

{% block body %}
    <main class="dashboard-main">
        {{ form_start(form) }}
        {{ form_widget(form) }}
        <button type="submit" class="btn btn-primary" onclick="return confirm('Are you sure ?')">Importer le CSV</button>
        {{ form_end(form) }}
        <p class="d-inline-flex gap-1">
            <a class="btn btn-primary" data-bs-toggle="collapse" href="#collapseExample" role="button" aria-expanded="false" aria-controls="collapseExample">
                Liste des véhicules :
            </a>
        </p>
        <div class="collapse" id="collapseExample">
            <a href="{{ path('dashboard_create_Car') }}">Ajouter un véhicule {{ ux_icon('zondicons:add-solid', {class: "add-button"}) }}</a>
            <br>
            <ul class="stations-container"></ul>
            {% for car in cars %}
                <li class="cars-unit"><strong>{{ car.brand }}, {{ car.model }}</strong>
                    <a href="{{ path('dashboard_edit_model', {'model': car.id}) }}">{{ ux_icon('bx:edit', {class: 'edit-button'}) }}</a>
                    <a href="{{ path('dashboard_delete_car', {'car': car.id}) }}" onclick="return confirm('are u sure?')">{{ ux_icon('icon-park-twotone:delete-three', {class: 'delete-button'}) }}</a></li>
            {% endfor %}
        </div>
    </main>
{% endblock %}
