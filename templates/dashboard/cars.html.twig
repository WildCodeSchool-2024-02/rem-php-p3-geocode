{% extends 'base.html.twig' %}

{% block body %}
    <main class="dashboard-main">
        {% for message in messages %}
            <div class="alert alert-{{ category }}">
                {{ message }}
            </div>
        {% endfor %}
        {{ form_start(form) }}
        {{ form_widget(form) }}
        <button type="submit" class="btn btn-primary" onclick="return confirm('Are you sure ?')">Importer le CSV</button>
        {{ form_end(form) }}
        <p class="d-inline-flex gap-1">
            <a class="btn btn-primary" data-bs-toggle="collapse" href="#collapseExample" role="button" aria-expanded="false" aria-controls="collapseExample">
                Liste des véhicules :
            </a>
        </p>
        <div class="collapse" id="collapseExample">
            <a href="#">Ajouter un véhicule</a>
            <br>
            <ul class="stations-container"></ul>
            {% for car in cars %}
                <li class="cars-unit"><strong>{{ car.brand }}, {{ car.model }}</strong> <a href="#">Modifier</a> <a href="#">Supprimer</a></li>
            {% endfor %}
        </div>
    </main>
{% endblock %}
