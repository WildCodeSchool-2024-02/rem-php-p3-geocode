{% extends 'base.html.twig' %}

{% block body %}
    <main class="dashboard-main">
        <p class="d-inline-flex gap-1">Liste des topics :
        </p>
        <div class="" id="collapseExample">
            <a href="{{ path('contact_new_topic') }}">Ajouter un topic</a>
            <br>
            <ul class="stations-container"></ul>
            {% for topic in topics %}
                <li class="cars-unit"><strong>{{ topic.name }}</strong> <a href="{{ path('contact_topic_edit', {'topic':  topic.id }) }}">Modifier</a>
                    <a href="{{ path('contact_topic_delete', {'topic': topic.id}) }}">Supprimer</a>
            {% endfor %}
        </div>
    </main>
{% endblock %}
