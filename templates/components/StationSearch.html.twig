<div{{ attributes }}>
    <div class="mb-3">
        <label class="form-label" for="search">
            Chercher une borne par code Insee :
        </label>
        <input type="search"
               id="search"
               class="form-control"
               data-model="query">
    </div>
    {% for station in this.stations %}
        <article>
            <h2 class="mt-4"> {{ station.id }} / {{ station.inseeCode }} -
                Adresse : {{ station.stationName }}, {{ station.stationAddress }}</h2>
            <p>{{ station.idStation }}
                <a href="{{ path('dashboard_edit_Station', {'stations': station.id}) }}">{{ ux_icon('bx:edit', {class: 'edit-button'}) }}</a>
                <a href="{{ path('dashboard_delete_Station', {'stations': station.id}) }}" onclick="return confirm('are u sure?')">{{ ux_icon('icon-park-twotone:delete-three', {class: 'delete-button'}) }}</a>
            </p>
        </article>
    {% endfor %}
</div>
